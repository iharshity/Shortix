# Server
PORT=4000
NODE_ENV=production

# MongoDB Atlas connection string
DB_URL=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/shortix

# Redis Cloud connection string
REDIS_URL=redis://default:<password>@xxxxx.cloud.redislabs.com:6379

# Public URL where this backend is deployed (no trailing slash)
PUBLIC_BASE_URL=https://your-backend.onrender.com

# Frontend URL for CORS (no trailing slash)
FRONTEND_URL=https://your-frontend.vercel.app

# JWT
JWT_SECRET=replace-with-a-long-random-secret-min-32-chars
JWT_EXPIRES_IN=7d
JWT_COOKIE_MAX_AGE_MS=604800000

# Bcrypt
BCRYPT_SALT_ROUNDS=12
